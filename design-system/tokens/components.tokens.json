{
  "component": {
    "$description": "Component tokens. Components read these through Tailwind's CSS-variable syntax, e.g. h-(--button-height-md).",
    "button": {
      "height": {
        "$type": "dimension",
        "xs": { "$value": "1.75rem" },
        "sm": { "$value": "2.25rem" },
        "md": { "$value": "2.75rem" },
        "lg": { "$value": "3rem" }
      },
      "padding-x": {
        "$type": "dimension",
        "xs": { "$value": "0.625rem" },
        "sm": { "$value": "0.875rem" },
        "md": { "$value": "1.25rem" },
        "lg": { "$value": "1.5rem" }
      },
      "radius": { "$type": "dimension", "$value": "{radius.full}", "$description": "Buttons are pills." }
    },
    "control": {
      "height": {
        "$type": "dimension",
        "sm": { "$value": "2.25rem" },
        "md": { "$value": "2.75rem" },
        "lg": { "$value": "3rem" }
      },
      "padding-x": { "$type": "dimension", "$value": "0.875rem" },
      "radius": { "$type": "dimension", "$value": "{radius.md}", "$description": "Inputs, selects, textareas, comboboxes." }
    },
    "card": {
      "radius": { "$type": "dimension", "$value": "{radius.lg}" },
      "padding": { "$type": "dimension", "$value": "1.5rem" },
      "padding-sm": { "$type": "dimension", "$value": "1rem" }
    },
    "panel": {
      "radius": { "$type": "dimension", "$value": "{radius.2xl}" },
      "padding": { "$type": "dimension", "$value": "clamp(1.5rem, 0.5rem + 5vw, 5rem)" }
    },
    "overlay": {
      "radius": { "$type": "dimension", "$value": "{radius.md}", "$description": "Menus, popovers, selects, hover cards." },
      "item-radius": { "$type": "dimension", "$value": "{radius.sm}" },
      "padding": { "$type": "dimension", "$value": "0.375rem" },
      "item-height": { "$type": "dimension", "$value": "2.25rem" }
    },
    "dialog": {
      "radius": { "$type": "dimension", "$value": "{radius.xl}" },
      "padding": { "$type": "dimension", "$value": "1.75rem" },
      "width": { "$type": "dimension", "$value": "32rem" }
    },
    "badge": {
      "height": { "$type": "dimension", "$value": "1.5rem" },
      "radius": { "$type": "dimension", "$value": "{radius.full}" }
    },
    "avatar": {
      "size": {
        "$type": "dimension",
        "sm": { "$value": "1.75rem" },
        "md": { "$value": "2.25rem" },
        "lg": { "$value": "3rem" },
        "xl": { "$value": "4.5rem" }
      }
    },
    "tabs": {
      "height": { "$type": "dimension", "$value": "2.75rem" }
    },
    "switch": {
      "width": { "$type": "dimension", "$value": "2.5rem" },
      "height": { "$type": "dimension", "$value": "1.5rem" }
    },
    "table": {
      "row-height": { "$type": "dimension", "$value": "3.25rem" }
    },
    "header": {
      "height": { "$type": "dimension", "$value": "4.5rem", "$description": "Site header and app top bar." }
    },
    "sidebar": {
      "width": { "$type": "dimension", "$value": "16rem" },
      "width-icon": { "$type": "dimension", "$value": "3.5rem" }
    }
  }
}
