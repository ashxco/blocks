{
  "component": {
    "$description": "Component tokens. Components read these through Tailwind's CSS-variable syntax, e.g. h-(--button-height-md).",
    "button": {
      "height": {
        "$type": "dimension",
        "xs": {
          "$value": "1.75rem"
        },
        "sm": {
          "$value": "2.25rem"
        },
        "md": {
          "$value": "2.75rem"
        },
        "lg": {
          "$value": "3rem"
        }
      },
      "padding-x": {
        "$type": "dimension",
        "xs": {
          "$value": "0.625rem"
        },
        "sm": {
          "$value": "0.875rem"
        },
        "md": {
          "$value": "1.25rem"
        },
        "lg": {
          "$value": "1.5rem"
        }
      },
      "radius": {
        "$type": "dimension",
        "$value": "{radius.full}",
        "$description": "Buttons are pills."
      }
    },
    "control": {
      "height": {
        "$type": "dimension",
        "sm": {
          "$value": "2.25rem"
        },
        "md": {
          "$value": "2.75rem"
        },
        "lg": {
          "$value": "3rem"
        },
        "xs": {
          "$value": "2rem"
        }
      },
      "padding-x": {
        "$type": "dimension",
        "$value": "0.875rem"
      },
      "radius": {
        "$type": "dimension",
        "$value": "{radius.md}",
        "$description": "Inputs, selects, textareas, comboboxes."
      }
    },
    "card": {
      "radius": {
        "$type": "dimension",
        "$value": "{radius.lg}"
      },
      "padding": {
        "$type": "dimension",
        "$value": "1.5rem"
      },
      "padding-sm": {
        "$type": "dimension",
        "$value": "1rem"
      }
    },
    "panel": {
      "radius": {
        "$type": "dimension",
        "$value": "{radius.2xl}"
      },
      "padding": {
        "$type": "dimension",
        "$value": "clamp(1.5rem, 0.5rem + 5vw, 5rem)"
      },
      "padding-sm": {
        "$type": "dimension",
        "$value": "clamp(1.5rem, 1rem + 2vw, 2.5rem)",
        "$description": "Panels inside app UI and narrow layouts."
      }
    },
    "overlay": {
      "radius": {
        "$type": "dimension",
        "$value": "{radius.md}",
        "$description": "Menus, popovers, selects, hover cards."
      },
      "item-radius": {
        "$type": "dimension",
        "$value": "{radius.sm}"
      },
      "padding": {
        "$type": "dimension",
        "$value": "0.375rem"
      },
      "item-height": {
        "$type": "dimension",
        "$value": "2.25rem"
      }
    },
    "popover": {
      "$type": "dimension",
      "width-sm": {
        "$value": "14rem",
        "$description": "Narrow popovers: a short form or a picker."
      },
      "width": {
        "$value": "18rem",
        "$description": "Default popover width."
      },
      "width-lg": {
        "$value": "24rem",
        "$description": "Wide popovers: notification lists, share panels."
      }
    },
    "hover-card": {
      "$type": "dimension",
      "width": {
        "$value": "18rem",
        "$description": "Hover card width."
      }
    },
    "menu": {
      "$type": "dimension",
      "min-width": {
        "$value": "12rem",
        "$description": "Dropdown, context and sub menus. Menus also grow to their trigger width."
      },
      "min-width-lg": {
        "$value": "14rem",
        "$description": "Menubar menus and combobox lists."
      }
    },
    "tooltip": {
      "$type": "dimension",
      "max-width": {
        "$value": "16rem",
        "$description": "Tooltips wrap beyond this width."
      }
    },
    "toast": {
      "$type": "dimension",
      "width": {
        "$value": "24rem",
        "$description": "Toast width from sm up; full width minus the gutter below."
      }
    },
    "command": {
      "$type": "dimension",
      "input-height": {
        "$value": "3.5rem",
        "$description": "Search row of the command dialog."
      },
      "item-height": {
        "$value": "2.5rem",
        "$description": "Result rows in the command dialog."
      },
      "footer-height": {
        "$value": "2.75rem",
        "$description": "Key-hint footer of the command dialog."
      }
    },
    "dialog": {
      "radius": {
        "$type": "dimension",
        "$value": "{radius.xl}"
      },
      "padding": {
        "$type": "dimension",
        "$value": "1.75rem"
      },
      "width": {
        "$type": "dimension",
        "$value": "32rem"
      },
      "width-sm": {
        "$type": "dimension",
        "$value": "24rem",
        "$description": "Small dialogs: confirmations."
      },
      "width-lg": {
        "$type": "dimension",
        "$value": "{container.prose}",
        "$description": "Large dialogs: forms and long content."
      }
    },
    "badge": {
      "height": {
        "$type": "dimension",
        "$value": "1.5rem"
      },
      "radius": {
        "$type": "dimension",
        "$value": "{radius.full}"
      }
    },
    "avatar": {
      "size": {
        "$type": "dimension",
        "sm": {
          "$value": "1.75rem"
        },
        "md": {
          "$value": "2.25rem"
        },
        "lg": {
          "$value": "3rem"
        },
        "xl": {
          "$value": "4.5rem"
        }
      }
    },
    "tabs": {
      "height": {
        "$type": "dimension",
        "$value": "2.75rem"
      }
    },
    "switch": {
      "width": {
        "$type": "dimension",
        "$value": "2.5rem"
      },
      "height": {
        "$type": "dimension",
        "$value": "1.5rem"
      },
      "width-sm": {
        "$type": "dimension",
        "$value": "2rem"
      },
      "height-sm": {
        "$type": "dimension",
        "$value": "1.25rem"
      }
    },
    "table": {
      "row-height": {
        "$type": "dimension",
        "$value": "3.25rem"
      },
      "row-height-sm": {
        "$type": "dimension",
        "$value": "2.75rem"
      }
    },
    "header": {
      "height": {
        "$type": "dimension",
        "$value": "4.5rem",
        "$description": "Site header and app top bar."
      },
      "height-sm": {
        "$type": "dimension",
        "$value": "3.5rem",
        "$description": "Slim bars: the viewer and dense app chrome."
      }
    },
    "sidebar": {
      "width": {
        "$type": "dimension",
        "$value": "16rem"
      },
      "width-icon": {
        "$type": "dimension",
        "$value": "3.5rem"
      },
      "width-mobile": {
        "$type": "dimension",
        "$value": "18rem"
      }
    },
    "selection": {
      "size": {
        "$type": "dimension",
        "$value": "1.125rem",
        "$description": "Checkbox and radio size."
      }
    },
    "otp": {
      "slot-width": {
        "$type": "dimension",
        "$value": "2.75rem"
      }
    },
    "calendar": {
      "cell-size": {
        "$type": "dimension",
        "$value": "2.5rem"
      }
    },
    "sheet": {
      "width": {
        "$type": "dimension",
        "$value": "28rem",
        "$description": "Side sheet and drawer width."
      }
    },
    "scrollbar": {
      "size": {
        "$type": "dimension",
        "$value": "0.625rem"
      }
    }
  }
}
