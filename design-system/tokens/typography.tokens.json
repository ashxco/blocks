{
  "type": {
    "$type": "typography",
    "$description": "Type roles. Each compiles to a Tailwind text-* utility that sets size, line height, tracking and weight together.",
    "hero": {
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": "clamp(4rem, 1.5rem + 9vw, 10rem)",
        "fontWeight": "{font.weight.extrabold}",
        "letterSpacing": "-0.055em",
        "lineHeight": "0.9"
      },
      "$description": "Oversized statement for showcase pages such as the design-system overview."
    },
    "display": {
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": "clamp(2.75rem, 1.55rem + 4.6vw, 5rem)",
        "fontWeight": "{font.weight.extrabold}",
        "letterSpacing": "-0.045em",
        "lineHeight": "1"
      },
      "$description": "Hero headline. One per page."
    },
    "h1": {
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": "clamp(2.4rem, 1.65rem + 2.9vw, 3.9rem)",
        "fontWeight": "{font.weight.extrabold}",
        "letterSpacing": "-0.042em",
        "lineHeight": "1.02"
      },
      "$description": "Page title on inner pages."
    },
    "h2": {
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": "clamp(2rem, 1.5rem + 2vw, 3rem)",
        "fontWeight": "{font.weight.extrabold}",
        "letterSpacing": "-0.04em",
        "lineHeight": "1.06"
      },
      "$description": "Section heading."
    },
    "h3": {
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": "clamp(1.4rem, 1.2rem + 0.8vw, 1.75rem)",
        "fontWeight": "{font.weight.bold}",
        "letterSpacing": "-0.03em",
        "lineHeight": "1.15"
      },
      "$description": "Sub-section heading and large card titles."
    },
    "h4": {
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": "1.25rem",
        "fontWeight": "{font.weight.bold}",
        "letterSpacing": "-0.022em",
        "lineHeight": "1.25"
      },
      "$description": "Card and dialog titles."
    },
    "title": {
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": "1.0625rem",
        "fontWeight": "{font.weight.bold}",
        "letterSpacing": "-0.015em",
        "lineHeight": "1.35"
      },
      "$description": "Small titles: list items, tiles, table headers in marketing."
    },
    "lead": {
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": "clamp(1.0625rem, 1rem + 0.25vw, 1.1875rem)",
        "fontWeight": "{font.weight.regular}",
        "letterSpacing": "-0.006em",
        "lineHeight": "1.6"
      },
      "$description": "Intro paragraph under a headline."
    },
    "body": {
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": "1rem",
        "fontWeight": "{font.weight.regular}",
        "letterSpacing": "0em",
        "lineHeight": "1.65"
      },
      "$description": "Default paragraph text."
    },
    "label": {
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": "0.875rem",
        "fontWeight": "{font.weight.semibold}",
        "letterSpacing": "-0.005em",
        "lineHeight": "1.4"
      },
      "$description": "Form labels, buttons and navigation."
    },
    "control": {
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": "1rem",
        "fontWeight": "{font.weight.regular}",
        "letterSpacing": "0em",
        "lineHeight": "1.6"
      },
      "$extensions": {
        "blocks": {
          "breakpoints": {
            "md": { "fontSize": "0.875rem", "lineHeight": "1.45" }
          }
        }
      },
      "$description": "Text typed into inputs, selects, comboboxes and textareas. 16px on phones, so iOS does not zoom into a focused field, and 14px from md up."
    },
    "caption": {
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": "0.8125rem",
        "fontWeight": "{font.weight.regular}",
        "letterSpacing": "0em",
        "lineHeight": "1.45"
      },
      "$description": "Meta text, timestamps and helper text."
    },
    "code": {
      "$value": {
        "fontFamily": "{font.family.mono}",
        "fontSize": "0.8125rem",
        "fontWeight": "{font.weight.regular}",
        "letterSpacing": "0em",
        "lineHeight": "1.7"
      },
      "$description": "Inline code, commands and terminal output. Pair with font-mono."
    },
    "xs": {
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": "0.75rem",
        "fontWeight": "{font.weight.regular}",
        "letterSpacing": "0em",
        "lineHeight": "1.35"
      },
      "$description": "Scale step for dense UI."
    },
    "sm": {
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": "0.875rem",
        "fontWeight": "{font.weight.regular}",
        "letterSpacing": "0em",
        "lineHeight": "1.45"
      },
      "$description": "Scale step for UI text."
    },
    "base": {
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": "1rem",
        "fontWeight": "{font.weight.regular}",
        "letterSpacing": "0em",
        "lineHeight": "1.6"
      },
      "$description": "Scale step for body text."
    },
    "lg": {
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": "1.125rem",
        "fontWeight": "{font.weight.regular}",
        "letterSpacing": "-0.005em",
        "lineHeight": "1.55"
      },
      "$description": "Scale step."
    },
    "xl": {
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": "1.25rem",
        "fontWeight": "{font.weight.regular}",
        "letterSpacing": "-0.01em",
        "lineHeight": "1.4"
      },
      "$description": "Scale step."
    },
    "2xl": {
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": "1.5rem",
        "fontWeight": "{font.weight.regular}",
        "letterSpacing": "-0.02em",
        "lineHeight": "1.3"
      },
      "$description": "Scale step."
    },
    "3xl": {
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": "1.875rem",
        "fontWeight": "{font.weight.regular}",
        "letterSpacing": "-0.025em",
        "lineHeight": "1.2"
      },
      "$description": "Scale step."
    },
    "4xl": {
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": "2.25rem",
        "fontWeight": "{font.weight.regular}",
        "letterSpacing": "-0.03em",
        "lineHeight": "1.12"
      },
      "$description": "Scale step."
    },
    "5xl": {
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": "3rem",
        "fontWeight": "{font.weight.regular}",
        "letterSpacing": "-0.035em",
        "lineHeight": "1.05"
      },
      "$description": "Scale step."
    },
    "6xl": {
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": "3.75rem",
        "fontWeight": "{font.weight.regular}",
        "letterSpacing": "-0.04em",
        "lineHeight": "1"
      },
      "$description": "Scale step."
    },
    "7xl": {
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": "4.5rem",
        "fontWeight": "{font.weight.regular}",
        "letterSpacing": "-0.045em",
        "lineHeight": "1"
      },
      "$description": "Scale step."
    }
  }
}
