        "letterSpacing": "-0.022em"
      }
    },
    "h4": {
      "$value": {
        "letterSpacing": "-0.016em"
      }
    },
    "title": {
      "$value": {
        "letterSpacing": "-0.01em"
      }
    }
  },
  "light": {
    "color": {
      "brand": {
        "$value": "{theme.neutral.950}"
      },
      "brand-foreground": {
        "$value": "{theme.neutral.0}"
      },
      "brand-subtle": {
        "$value": "{theme.neutral.150}"
      },
      "brand-subtle-foreground": {
        "$value": "{theme.neutral.950}"
      },
      "ring": {
        "$value": "{theme.neutral.550}",
        "$description": "Graphite, not ink: it keeps 3:1 on the canvas and on dark panels, where an ink ring would vanish."
      },
      "panel-brand": {
        "$value": "{theme.neutral.0}"
      },
      "tint": {
        "$description": "Lightness is the only cue without hue. Neighbouring tints in this order (wrapping round) sit at least 0.04 L apart, and mint stays 0.055 L from secondary, the +N chip after an avatar stack. The strength order matches in both modes: rose, sand, violet, mint, sky (the lightest, for large tiles).",
        "violet": {
          "$value": "oklch(0.86 0 0)"
        },
        "mint": {
          "$value": "{theme.neutral.200}"
        },
        "sand": {
          "$value": "{theme.neutral.300}"
        },
        "sky": {
          "$value": "{theme.neutral.150}"
        },
        "rose": {
          "$value": "oklch(0.78 0 0)"
        }
      },
      "chart": {
        "$description": "Series 1 to 4 step from ink to light grey. Series 5 is the neutral comparison grey every theme uses (Previous period, Late) at L 0.68, between 3 and 4, so it reads lighter than series 1. Any two series sit at least 0.14 L apart.",
        "1": {
          "$value": "{theme.neutral.950}"
        },
        "2": {
          "$value": "{theme.neutral.750}"
        },
        "3": {
          "$value": "{theme.neutral.550}"
        },
        "4": {
          "$value": "{theme.neutral.300}"
        },
        "5": {
          "$value": "{theme.neutral.400}"
        }
      },
      "sidebar": {
        "ring": {
          "$value": "{theme.neutral.550}"
        }
      }
    }
  },
  "dark": {
    "color": {
      "brand": {
        "$value": "{theme.neutral.25}"
      },
      "brand-foreground": {
        "$value": "{theme.neutral.1000}"
      },
      "brand-subtle": {
        "$value": "{theme.neutral.800}"
      },
      "brand-subtle-foreground": {
        "$value": "{theme.neutral.25}"
      },
      "ring": {
        "$value": "{theme.neutral.25}"
      },
      "panel-brand": {
        "$value": "{theme.neutral.0}"
      },
      "tint": {
        "$description": "Lightness is the only cue without hue. Neighbouring tints in this order (wrapping round) sit at least 0.04 L apart, and mint stays 0.055 L from secondary, the +N chip after an avatar stack. The strength order matches in both modes: rose, sand, violet, mint, sky (the lightest, for large tiles).",
        "violet": {
          "$value": "{theme.neutral.750}"
        },
        "mint": {
          "$value": "{theme.neutral.800}"
        },
        "sand": {
          "$value": "{theme.neutral.700}"
        },
        "sky": {
          "$value": "oklch(0.24 0 0)"
        },
        "rose": {
          "$value": "oklch(0.4 0 0)"
        }
      },
      "chart": {
        "$description": "Series 1 to 4 step from near-white down to a grey that still holds 3:1 on the dark card, about 0.125 L apart, the widest even spread that range allows. Series 5, the comparison grey, sits between 3 and 4, as in light mode.",
        "1": {
          "$value": "{theme.neutral.25}"
        },
        "2": {
          "$value": "oklch(0.86 0 0)"
        },
        "3": {
          "$value": "oklch(0.73 0 0)"
        },
        "4": {
          "$value": "oklch(0.48 0 0)"
        },
        "5": {
          "$value": "oklch(0.605 0 0)"
        }
      },
      "sidebar": {
