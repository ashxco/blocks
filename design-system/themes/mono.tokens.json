  "radius": {
    "xs": {
      "$value": "0.1875rem"
    },
    "sm": {
      "$value": "0.25rem"
    },
    "md": {
      "$value": "0.375rem"
    },
    "lg": {
      "$value": "0.5rem"
    },
    "xl": {
      "$value": "0.625rem"
    },
    "2xl": {
      "$value": "0.75rem"
    },
    "3xl": {
      "$value": "0.875rem"
    },
    "4xl": {
      "$value": "1rem"
    }
  },
  "component": {
    "button": {
      "radius": {
        "$value": "{radius.md}"
      }
    },
    "badge": {
      "radius": {
        "$value": "{radius.sm}"
      }
    },
    "kern": {
      "pull": {
        "$value": "0em"
      }
    },
    "link": {
      "decoration-line": {
        "$value": "underline",
        "$description": "The accent is ink, so links and active items carry an underline at rest."
      }
    },
    "brand-mark": {
      "ring": {
        "$value": "1.25px",
        "$description": "The accent point is ink like the tile, so a canvas-coloured ring keeps it visible."
      }
    }
  },
  "font": {
    "family": {
      "sans": {
        "$value": [
          "var(--font-geist)",
          "ui-sans-serif",
          "system-ui",
          "sans-serif"
        ],
        "$description": "Geist. Headings, UI and body copy.",
        "$extensions": {
          "blocks": {
            "name": "Geist"
          }
        }
      }
    }
  },
  "type": {
    "hero": {
      "$value": {
        "letterSpacing": "-0.038em"
      }
    },
    "display": {
      "$value": {
        "letterSpacing": "-0.03em"
      }
    },
    "h1": {
      "$value": {
        "letterSpacing": "-0.028em"
      }
    },
    "h2": {
