  "light": {
    "color": {
      "brand-subtle": {
        "$value": "{theme.accent.100}",
        "$description": "One step stronger than the default: the 50 tint sits on top of the warning amber fill, so brand badges would read as warnings."
      },
      "tint": {
        "violet": {
          "$value": "oklch(0.935 0.04 50)",
          "$description": "The first tint follows the accent: pale peach."
        },
        "sand": {
          "$value": "oklch(0.945 0.045 88)",
          "$description": "Moved towards butter so it stays apart from the peach first tint."
        },
        "sky": {
          "$value": "oklch(0.945 0.02 220)",
          "$description": "Softer, so it sits on warm stone without reading icy."
        },
        "rose": {
          "$value": "oklch(0.93 0.038 2)",
          "$description": "Moved from coral towards pink so it stays apart from the peach first tint beside it."
        }
      },
      "chart": {
        "4": {
          "$value": "{color.violet.400}",
          "$description": "Violet in place of amber: amber sits too close to the orange first series."
        }
      }
    }
  },
  "dark": {
    "color": {
      "brand-subtle-foreground": {
        "$value": "{theme.accent.300}",
        "$description": "One step stronger than the default so brand badges read orange on the dark ember fill, like the status badges beside them."
