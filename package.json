{
  "name": "blocks",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "tokens": "node design-system/build.mjs",
    "registry": "node scripts/build-registry.mjs",
    "package": "node scripts/build-package.mjs",
    "og": "node scripts/og.mjs",
    "predev": "npm run tokens && npm run registry",
    "prebuild": "npm run tokens && npm run registry",
    "lint:ds": "node scripts/lint-ds.mjs",
    "contrast": "node scripts/check-contrast.mjs",
    "themes": "node scripts/check-themes.mjs",
    "check": "npm run tokens && npm run registry && npm run contrast && npm run themes && tsc --noEmit --incremental false && npm run lint:ds",
    "verify": "npm run check && npm run lint && npm run build"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.4.0",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.5.0",
    "lucide-react": "^1.53.0",
    "next": "16.3.8",
    "next-themes": "^0.4.6",
    "react": "19.3.0",
    "react-day-picker": "^10.0.2",
    "react-dom": "19.3.0",
    "react-resizable-panels": "^4.14.3",
    "recharts": "^3.8.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "picomatch": "^4.0.7",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "style-dictionary": "^5.5.5",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
